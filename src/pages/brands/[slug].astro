---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { brands } from '@/data/brands';
export function getStaticPaths(){ return brands.map(brand => ({params:{slug:brand.slug},props:{brand}})); }
const { brand } = Astro.props;
const schema = {'@context':'https://schema.org','@type':'Product',name:brand.name,description:brand.summary,brand:{'@type':'Brand',name:brand.name},aggregateRating:{'@type':'AggregateRating',ratingValue:brand.score,bestRating:10,ratingCount:1}};
---
<BaseLayout title={`${brand.name}怎么样？品牌档案`} description={brand.summary} schema={schema}>
  <header class="dossier" style={`--brand:${brand.color}`}><div class="container dossier-grid"><div><span class="eyebrow">BRAND DOSSIER / {brand.status}</span><h1>{brand.name}<small>{brand.alias}</small></h1><p>{brand.summary}</p><div class="badges"><span>{brand.price}</span><span>适合 {brand.bestFor}</span><span>档案持续更新</span></div></div><div class="score"><small>岛民观察分</small><b>{brand.score}</b><span>/ 10</span><i>非永久结论</i></div></div></header>
  <section class="section"><div class="container content"><article class="prose"><h2>一分钟结论</h2><blockquote>{brand.name}当前更适合“{brand.bestFor}”场景。先按月购买、小范围验证，再决定是否长期使用。</blockquote><h2>我们记录到的优点</h2><ul>{brand.strengths.map(x=><li>{x}</li>)}</ul><h2>付款前要留意</h2><ul>{brand.cautions.map(x=><li>{x}</li>)}</ul><h2>价格与套餐观察</h2><table><thead><tr><th>观察项</th><th>当前记录</th><th>建议</th></tr></thead><tbody><tr><td>入门价格</td><td>{brand.price}</td><td>优先月付</td></tr><tr><td>适合人群</td><td>{brand.bestFor}</td><td>按主要场景选</td></tr><tr><td>档案状态</td><td>{brand.status}</td><td>购买前再次核对官网</td></tr></tbody></table><h2>编辑说明</h2><p>这是用于展示内容站结构的样本品牌档案。正式发布真实品牌内容前，请补充可复核的测试记录、采样日期、套餐截图与利益关系披露。</p></article><aside><div class="note"><b>更新清单</b><span>□ 最新价格</span><span>□ 晚高峰复测</span><span>□ 流媒体解锁</span><span>□ 售后响应</span></div></aside></div></section>
</BaseLayout>
<style>
  .dossier{padding:72px 0;border-bottom:var(--line);background:var(--brand)}.dossier-grid{display:grid;grid-template-columns:1fr 250px;gap:70px;align-items:end}h1{margin:18px 0;font-size:clamp(4rem,9vw,8rem);line-height:.85;letter-spacing:-.08em}h1 small{display:block;margin-top:20px;font:700 .9rem 'IBM Plex Mono';letter-spacing:.05em}.dossier p{max-width:750px;font-size:1.15rem;font-weight:600}.badges{display:flex;gap:8px;flex-wrap:wrap}.badges span{padding:5px 9px;border:1.5px solid;background:var(--paper);font-size:.75rem;font-weight:800}.score{display:flex;min-height:250px;flex-direction:column;padding:22px;border:var(--line);background:var(--paper);box-shadow:8px 8px 0 var(--ink);transform:rotate(2deg)}.score small{font-weight:800}.score b{margin:auto 0 0;font:900 6rem/1 'IBM Plex Mono';letter-spacing:-.1em}.score span{text-align:right}.score i{margin-top:auto;color:var(--orange);font-weight:900}.content{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:50px}.note{position:sticky;top:100px;display:flex;flex-direction:column;gap:10px;padding:20px;border:var(--line);background:var(--lime);box-shadow:var(--shadow)}.note b{font-size:1.1rem;margin-bottom:5px}@media(max-width:760px){.dossier-grid,.content{grid-template-columns:1fr}.score{display:none}.note{position:static}}
</style>
