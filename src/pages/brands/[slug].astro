---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { brands } from '@/data/brands';
export function getStaticPaths(){ return brands.map(brand => ({params:{slug:brand.slug},props:{brand}})); }
const { brand } = Astro.props;
const schema = {'@context':'https://schema.org','@type':'Product',name:brand.name,description:brand.summary,brand:{'@type':'Brand',name:brand.name},offers:{'@type':'Offer',priceCurrency:'CNY',url:brand.affiliateUrl},aggregateRating:{'@type':'AggregateRating',ratingValue:brand.score,bestRating:10,ratingCount:1}};
---
<BaseLayout title={`${brand.name}怎么样？品牌档案`} description={brand.summary} schema={schema}>
  <header class="dossier" style={`--brand:${brand.color}`}><div class="container dossier-grid"><div><span class="eyebrow">BRAND DOSSIER / {brand.status}</span><h1>{brand.name}<small>{brand.alias}</small></h1><p>{brand.summary}</p><div class="badges"><span>{brand.price}</span><span>适合 {brand.bestFor}</span><span>档案持续更新</span></div></div><div class="score"><small>岛民观察分</small><b>{brand.score}</b><span>/ 10</span><i>非永久结论</i></div></div></header>
  <section class="section"><div class="container content"><article class="prose"><div class:list={{ deal:true, primary:brand.primary }}><span>{brand.primary ? '本期主推' : '套餐入口'}</span><strong>{brand.price} · {brand.traffic} · {brand.lineType}</strong><code>{brand.coupon}</code><a href={brand.affiliateUrl} target="_blank" rel="sponsored nofollow noopener">访问官方入口 ↗</a><small>推广链接：我们可能获得佣金；不会增加你的购买价格。</small></div><h2>一分钟结论</h2><blockquote>{brand.name}当前更适合“{brand.bestFor}”场景。先按月购买、小范围验证，再决定是否长期使用。</blockquote><h2>我们记录到的优点</h2><ul>{brand.strengths.map(x=><li>{x}</li>)}</ul><h2>付款前要留意</h2><ul>{brand.cautions.map(x=><li>{x}</li>)}</ul><h2>价格与套餐观察</h2><table><thead><tr><th>观察项</th><th>当前记录</th><th>建议</th></tr></thead><tbody><tr><td>月付价格</td><td>{brand.price}</td><td>优先月付试用</td></tr><tr><td>月流量</td><td>{brand.traffic}</td><td>按设备与视频用量估算</td></tr><tr><td>线路类型</td><td>{brand.lineType}</td><td>仍需用本地网络实测</td></tr><tr><td>优惠信息</td><td>{brand.coupon}</td><td>结算前确认是否生效</td></tr></tbody></table><p><a href={brand.reviewUrl}>阅读完整的 {brand.name} 测评 →</a></p><h2>编辑说明</h2><p>本页套餐资料按 2026 年 10 月 8 日收到的信息整理。机场线路、价格、优惠码和节点状态可能随时调整，购买前请以官网实时页面为准。</p></article><aside><div class="note"><b>购买前检查</b><span>□ 优惠码已生效</span><span>□ 套餐仍支持月付</span><span>□ 流量满足设备数量</span><span>□ 先完成晚高峰测试</span></div></aside></div></section>
</BaseLayout>
<style>
  .dossier{padding:72px 0;border-bottom:var(--line);background:var(--brand)}.dossier-grid{display:grid;grid-template-columns:1fr 250px;gap:70px;align-items:end}h1{margin:18px 0;font-size:clamp(4rem,9vw,8rem);line-height:.85;letter-spacing:-.08em}h1 small{display:block;margin-top:20px;font:700 .9rem 'IBM Plex Mono';letter-spacing:.05em}.dossier p{max-width:750px;font-size:1.15rem;font-weight:600}.badges{display:flex;gap:8px;flex-wrap:wrap}.badges span{padding:5px 9px;border:1.5px solid;background:var(--paper);font-size:.75rem;font-weight:800}.score{display:flex;min-height:250px;flex-direction:column;padding:22px;border:var(--line);background:var(--paper);box-shadow:8px 8px 0 var(--ink);transform:rotate(2deg)}.score small{font-weight:800}.score b{margin:auto 0 0;font:900 6rem/1 'IBM Plex Mono';letter-spacing:-.1em}.score span{text-align:right}.score i{margin-top:auto;color:var(--orange);font-weight:900}.content{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:50px}.note{position:sticky;top:100px;display:flex;flex-direction:column;gap:10px;padding:20px;border:var(--line);background:var(--lime);box-shadow:var(--shadow)}.note b{font-size:1.1rem;margin-bottom:5px}.deal{display:grid;gap:9px;margin-bottom:30px;padding:20px;border:var(--line);border-radius:12px;background:var(--blue);box-shadow:var(--shadow)}.deal.primary{background:var(--lime);box-shadow:7px 7px 0 var(--orange)}.deal>span{font:700 .7rem 'IBM Plex Mono'}.deal>strong{font-size:1.25rem}.deal code{width:max-content;background:var(--paper);color:var(--ink);border:1.5px dashed;padding:7px 10px;font-weight:900}.deal a{width:max-content;padding:9px 14px;border:var(--line);border-radius:999px;background:var(--ink);color:white;text-decoration:none}.deal small{color:var(--muted)}@media(max-width:760px){.dossier-grid,.content{grid-template-columns:1fr}.score{display:none}.note{position:static}}
</style>
