---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { brands } from '@/data/brands';
---
<BaseLayout title="机场品牌档案" description="按品牌查看机场基础信息、价格、优势、注意事项和关联评测。">
  <header class="brand-hero"><div class="container"><span class="eyebrow">一个名字，一整柜证据</span><h1>品牌档案柜</h1><p>每个品牌页都能承载基础资料、价格记录、更新时间线、评测结论和相关文章。今天看热闹，明天做品牌词 SEO。</p></div></header>
  <section class="section"><div class="container brand-grid">{brands.map((brand,index) => <a class="brand-card" href={`/brands/${brand.slug}`} style={`--brand:${brand.color}`}><div class="file-tab mono">FILE / 00{index+1}</div><div class="status">● {brand.status}</div><div class="mascot">{brand.name.slice(0,1)}<i></i></div><h2>{brand.name}</h2><p class="alias mono">AKA. {brand.alias}</p><p>{brand.summary}</p><div class="row"><span>适合：{brand.bestFor}</span><b>{brand.score}</b></div><strong>抽出档案 →</strong></a>)}</div></section>
</BaseLayout>
<style>
  .brand-hero{padding:75px 0;border-bottom:var(--line);background:var(--blue)}h1{margin:14px 0;font-size:clamp(3.4rem,8vw,8rem);line-height:.9;letter-spacing:-.075em}.brand-hero p{max-width:720px;font-size:1.15rem;font-weight:600}.brand-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}.brand-card{position:relative;padding:25px;border:var(--line);border-top:12px solid var(--brand);border-radius:4px 4px 15px 15px;background:#fffdf8;box-shadow:var(--shadow);transition:.2s}.brand-card:hover{transform:translateY(-7px) rotate(-.5deg);box-shadow:8px 12px 0 var(--ink)}.file-tab{position:absolute;left:18px;top:-33px;padding:5px 14px;border:var(--line);border-bottom:0;background:var(--brand);font-size:.67rem}.status{text-align:right;font-size:.7rem;font-weight:800}.mascot{position:relative;display:grid;place-items:center;width:110px;height:110px;margin:25px auto 12px;border:var(--line);border-radius:45% 55% 50% 47%;background:var(--brand);font-size:3.5rem;font-weight:900;transform:rotate(-5deg)}.mascot i{position:absolute;width:18px;height:18px;right:13px;top:18px;border:var(--line);border-radius:50%;background:var(--paper)}h2{margin:10px 0 0;text-align:center;font-size:2rem}.alias{text-align:center;font-size:.75rem}.brand-card>p:not(.alias){min-height:82px;color:var(--muted)}.row{display:flex;align-items:center;justify-content:space-between;padding:13px 0;border-block:1.5px dashed;font-size:.8rem}.row b{font:900 1.8rem 'IBM Plex Mono'}.brand-card>strong{display:block;margin-top:17px}.brand-card:hover>strong{text-decoration:underline;text-decoration-color:var(--brand);text-decoration-thickness:4px}@media(max-width:850px){.brand-grid{grid-template-columns:1fr}.brand-card>p:not(.alias){min-height:0}}
</style>
