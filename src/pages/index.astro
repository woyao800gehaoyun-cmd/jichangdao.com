---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Newsletter from '@/components/Newsletter.astro';
import { brands } from '@/data/brands';

const all = [
  ...(await getCollection('reviews')).map(x => ({...x, path:'reviews'})),
  ...(await getCollection('guides')).map(x => ({...x, path:'guides'})),
  ...(await getCollection('compare')).map(x => ({...x, path:'compare'}))
].sort((a,b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf());
const featured = all.filter(x => x.data.featured).slice(0,3);
const latest = all.slice(0,4);
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">独立观察 · 人类实测 · 持续复核</span>
        <h1 class="display">别急着<br />买<span>机票</span>。</h1>
        <p class="lede">这里不卖“秒开 8K”的空气。我们把线路、价格、售后和营销黑话塞进安检机，看看最后还剩下什么。</p>
        <div class="hero-actions"><a class="button" href="/reviews">开始翻档案 →</a><a class="button light" href="/guides/how-we-test">偷看测试方法</a></div>
        <div class="proof mono"><span><b>27</b> 项检查</span><span><b>19:00–23:00</b> 高峰复测</span><span><b>0</b> 元充值信仰</span></div>
      </div>
      <div class="hero-machine" aria-hidden="true">
        <div class="machine-top"><span>JCD // 安检机 404</span><i></i></div>
        <div class="screen"><div class="scan-line"></div><span class="cloud">☁</span><b>正在扫描<br/>“永久稳定”</b><small>检测到 3 个可疑形容词</small></div>
        <div class="buttons"><i></i><i></i><i></i><span>不要拍打机器</span></div>
        <div class="paper"><b>检查结果</b><span>速度 ███████░░ 7.2</span><span>稳定 ████████░ 8.1</span><span>话术 ██████████ 10</span><em>建议：先月付，别梭哈。</em></div>
      </div>
      <div class="sticker">拒绝<br/>空气<br/>测速</div>
    </div>
  </section>

  <div class="marquee"><div class="marquee-track"><span>LATENCY ↓ • TRUTH ↑ • 晚高峰才是照妖镜 • 先月付再谈感情 • </span><span>LATENCY ↓ • TRUTH ↑ • 晚高峰才是照妖镜 • 先月付再谈感情 • </span><span>LATENCY ↓ • TRUTH ↑ • 晚高峰才是照妖镜 • 先月付再谈感情 • </span><span>LATENCY ↓ • TRUTH ↑ • 晚高峰才是照妖镜 • 先月付再谈感情 • </span></div></div>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">编辑部拿放大镜盯着看</span><h2 class="section-title">本周重点档案</h2></div><a class="button light" href="/reviews">全部评测 →</a></div>
      <div class="grid-3">{featured.map(item => <ArticleCard href={`/${item.path}/${item.id}`} {...item.data} date={item.data.publishedDate} />)}</div>
    </div>
  </section>

  <section class="method section">
    <div class="container method-grid">
      <div><span class="eyebrow">不是掐指一算</span><h2 class="section-title">一篇评测，<br/>要过四道闸。</h2><p class="lede">每次结论都记录测试环境与更新时间。服务会变，评价也必须跟着变。</p><a class="text-link" href="/guides/how-we-test">完整测试方法 →</a></div>
      <ol>
        <li><b>01</b><div><strong>钱包闸</strong><span>价格、续费、退款、流量规则</span></div></li>
        <li><b>02</b><div><strong>高峰闸</strong><span>连续测速、延迟抖动、丢包与可用率</span></div></li>
        <li><b>03</b><div><strong>内容闸</strong><span>流媒体、下载、办公与常见场景</span></div></li>
        <li><b>04</b><div><strong>人类闸</strong><span>客户端、文档、工单与故障沟通</span></div></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">品牌词不是彩虹屁</span><h2 class="section-title">可疑品牌档案柜</h2></div><a href="/brands" class="button light">打开全部抽屉 →</a></div>
      <div class="brand-list">{brands.map((brand,i) => <a href={`/brands/${brand.slug}`}><span class="mono">0{i+1}</span><i style={`background:${brand.color}`}></i><strong>{brand.name}</strong><small>{brand.alias}</small><em>{brand.bestFor}</em><b>{brand.score}</b><span>→</span></a>)}</div>
    </div>
  </section>

  <section class="latest section">
    <div class="container">
      <div class="section-head"><div><span class="eyebrow">新鲜出机</span><h2 class="section-title">最近更新</h2></div></div>
      <div class="latest-grid">{latest.map((item,index) => <a href={`/${item.path}/${item.id}`}><b class="mono">{String(index+1).padStart(2,'0')}</b><div><span class="tag">{item.data.category}</span><h3>{item.data.title}</h3><p>{item.data.description}</p></div><time class="mono">{item.data.publishedDate.toLocaleDateString('zh-CN')}</time><i>↗</i></a>)}</div>
    </div>
  </section>

  <section class="section"><div class="container"><Newsletter /></div></section>
</BaseLayout>

<style>
  .hero { min-height: calc(100vh - 74px); display:flex; align-items:center; padding:70px 0 90px; overflow:hidden; }
  .hero-grid { position:relative; display:grid; grid-template-columns:1.18fr .82fr; gap:70px; align-items:center; }
  .hero-copy { position:relative; z-index:2; }
  .display span { display:inline-block; padding:0 .1em .08em; margin-left:.05em; border:var(--line); background:var(--orange); box-shadow:5px 5px 0 var(--ink); transform:rotate(-2deg); }
  .hero-copy .lede { margin:30px 0; }
  .hero-actions { display:flex; gap:13px; flex-wrap:wrap; }
  .proof { display:flex; gap:25px; margin-top:36px; font-size:.72rem; }
  .proof span { display:flex; flex-direction:column; }.proof b{font-size:1.05rem;color:var(--orange)}
  .hero-machine { position:relative; border:var(--line); border-radius:25px 25px 14px 14px; background:#b9b3a8; box-shadow:12px 12px 0 var(--ink); transform:rotate(1.2deg); }
  .machine-top { display:flex; justify-content:space-between; padding:13px 18px; border-bottom:var(--line); font:700 .7rem 'IBM Plex Mono'; }
  .machine-top i { width:10px;height:10px;border:1px solid;border-radius:50%;background:var(--orange);box-shadow:18px 0 0 var(--lime); }
  .screen { position:relative; min-height:300px; margin:20px; display:flex; flex-direction:column; align-items:center; justify-content:center; border:var(--line); border-radius:10px; background:var(--ink); color:var(--lime); overflow:hidden; text-align:center; }
  .screen::before { content:'';position:absolute;inset:0;background:linear-gradient(#ffffff09 50%,transparent 50%);background-size:100% 5px; }
  .cloud { font-size:5rem; filter:grayscale(1); }.screen b{font:700 1.3rem/1.3 'IBM Plex Mono';}.screen small{margin-top:13px;color:var(--orange)}
  .scan-line { position:absolute;inset:0 0 auto;height:4px;background:var(--lime);box-shadow:0 0 20px var(--lime);animation:scan 3s ease-in-out infinite alternate; }
  @keyframes scan{to{transform:translateY(296px)}}
  .buttons { display:flex;gap:10px;align-items:center;padding:0 20px 20px;}.buttons i{width:18px;height:18px;border:var(--line);border-radius:50%;background:var(--orange)}.buttons i:nth-child(2){background:var(--lime)}.buttons i:nth-child(3){background:var(--blue)}.buttons span{margin-left:auto;font-size:.7rem;font-weight:800}
  .paper { position:absolute;display:flex;flex-direction:column;gap:5px;width:230px;right:-35px;bottom:-115px;padding:18px;border:var(--line);background:#fffdf8;box-shadow:5px 5px 0 var(--ink);font:700 .72rem/1.5 'IBM Plex Mono';transform:rotate(-4deg);}.paper b{font-size:1rem;border-bottom:1px dashed}.paper em{margin-top:5px;color:var(--orange);font-style:normal}
  .hero .sticker { right:-42px;top:-33px; }
  .method { background:var(--ink);color:var(--paper); }
  .method .eyebrow::before{background:var(--lime)}.method .lede{color:#bcb7ae}.method-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}.text-link{display:inline-block;margin-top:15px;color:var(--lime);font-weight:800;text-decoration:underline}
  .method ol{list-style:none;padding:0;margin:0;border-top:1px solid #666}.method li{display:grid;grid-template-columns:60px 1fr;gap:20px;padding:22px 0;border-bottom:1px solid #666}.method li>b{font:700 .78rem 'IBM Plex Mono';color:var(--orange)}.method li div{display:flex;justify-content:space-between;gap:20px}.method li strong{font-size:1.2rem}.method li span{color:#aaa;font-size:.9rem;text-align:right}
  .brand-list { border-top:var(--line); }.brand-list a{display:grid;grid-template-columns:35px 15px 1.2fr 1fr 1fr 55px 20px;gap:15px;align-items:center;padding:18px 8px;border-bottom:var(--line);transition:.15s}.brand-list a:hover{padding-left:16px;background:var(--lime)}.brand-list i{width:13px;height:13px;border:1px solid;border-radius:50%}.brand-list strong{font-size:1.28rem}.brand-list small,.brand-list em{color:var(--muted);font-style:normal}.brand-list b{font:900 1.4rem 'IBM Plex Mono'}
  .latest{background:#e6dfd2}.latest-grid{border-top:var(--line)}.latest-grid>a{display:grid;grid-template-columns:55px 1fr 100px 30px;gap:24px;align-items:center;padding:24px 6px;border-bottom:var(--line)}.latest-grid>a:hover h3{text-decoration:underline;text-decoration-color:var(--orange);text-decoration-thickness:4px}.latest h3{margin:7px 0 2px;font-size:1.35rem}.latest p{margin:0;color:var(--muted)}.latest time{font-size:.72rem}.latest i{font-size:1.6rem}
  @media(max-width:900px){.hero{min-height:auto}.hero-grid,.method-grid{grid-template-columns:1fr}.hero-machine{max-width:520px;margin:auto}.hero .sticker{display:none}.brand-list a{grid-template-columns:30px 12px 1fr 55px 20px}.brand-list small,.brand-list em{display:none}}
  @media(max-width:600px){.hero{padding-top:50px}.hero-machine{margin-bottom:85px}.proof{flex-wrap:wrap}.method li div{flex-direction:column;gap:2px}.method li span{text-align:left}.latest-grid>a{grid-template-columns:34px 1fr 24px}.latest time{display:none}.latest p{display:none}}
</style>
