---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '@/layouts/ArticleLayout.astro';
export async function getStaticPaths(){ return (await getCollection('guides')).map(entry => ({ params:{slug:entry.id}, props:{entry} })); }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<ArticleLayout entry={entry} headings={headings}><Content /></ArticleLayout>
