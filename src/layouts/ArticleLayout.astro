---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'reviews' | 'guides' | 'compare'>;
  headings: { depth: number; slug: string; text: string }[];
}
const { entry, headings } = Astro.props;
const d = entry.data;
const pathMap = { reviews: 'reviews', guides: 'guides', compare: 'compare' };
const categoryMap = { reviews: '荒野评测', guides: '逃生教程', compare: '擂台对比' };
const url = `/${pathMap[entry.collection]}/${entry.id.replace(/\.mdx?$/, '')}`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  datePublished: d.publishedDate.toISOString(),
  dateModified: (d.updatedDate || d.publishedDate).toISOString(),
  inLanguage: 'zh-CN',
  mainEntityOfPage: `https://jichangdao.com${url}`,
  author: { '@type': 'Organization', name: '机场岛编辑部' },
  publisher: { '@type': 'Organization', name: '机场岛', logo: { '@type': 'ImageObject', url: 'https://jichangdao.com/favicon.svg' } }
};
---
<BaseLayout title={d.title} description={d.description} canonical={url} schema={articleSchema}>
  <header class={`article-hero ${d.accent}`}>
    <div class="container hero-grid">
      <div>
        <div class="breadcrumbs mono"><a href="/">首页</a><span>/</span><a href={`/${pathMap[entry.collection]}`}>{categoryMap[entry.collection]}</a><span>/</span><span>当前档案</span></div>
        <div class="flags"><span>{d.category}</span><span>最后复核：{(d.updatedDate || d.publishedDate).toLocaleDateString('zh-CN')}</span></div>
        <h1>{d.title}</h1>
        <p>{d.description}</p>
        <div class="article-meta mono"><span>发布 {d.publishedDate.toLocaleDateString('zh-CN')}</span><span>预计阅读 {d.readingMinutes} 分钟</span><span>{d.tags.join(' / ')}</span></div>
      </div>
      <div class="passport" aria-label={d.score ? `评分 ${d.score}` : '指南文章'}>
        <small class="mono">JICHANGDAO / CASE FILE</small>
        <strong>{d.score?.toFixed(1) || 'HOW'}</strong>
        <span>{d.verdict || '先看方法，再动钱包'}</span>
        <i>已过安检 ✓</i>
      </div>
    </div>
  </header>
  <div class="container article-wrap section">
    <div class="article-shell">
      <article class="prose"><slot /></article>
      <aside class="toc">
        <strong class="mono">本页逃生路线</strong>
        {headings.filter(h => h.depth <= 3).map(h => <a class:list={{ sub: h.depth === 3 }} href={`#${h.slug}`}>{h.text}</a>)}
        <hr />
        <small>内容会随复测更新。发现数据过期？<a href="/contact">来敲值班室</a>。</small>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .article-hero { border-bottom: var(--line); padding: 52px 0 64px; background: var(--orange); }
  .article-hero.lime { background: var(--lime); } .article-hero.pink { background: var(--pink); } .article-hero.blue { background: var(--blue); }
  .hero-grid { display:grid; grid-template-columns:minmax(0,1fr) 250px; align-items:end; gap:60px; }
  .breadcrumbs { display:flex; flex-wrap:wrap; gap:8px; font-size:.72rem; margin-bottom:36px; }
  .breadcrumbs a { text-decoration:underline; }
  .flags { display:flex; gap:8px; flex-wrap:wrap; }
  .flags span { padding:5px 9px; border:1.5px solid; background:var(--paper); font-size:.72rem; font-weight:800; }
  h1 { max-width: 900px; margin:18px 0; font-size:clamp(2.7rem,6.5vw,6.6rem); line-height:.94; letter-spacing:-.065em; }
  .article-hero p { max-width:760px; font-size:1.15rem; font-weight:600; }
  .article-meta { display:flex; flex-wrap:wrap; gap:12px 22px; font-size:.74rem; font-weight:700; }
  .passport { position:relative; display:flex; min-height:300px; padding:23px; border:var(--line); border-radius:14px; background:var(--paper); box-shadow:8px 8px 0 var(--ink); flex-direction:column; justify-content:space-between; transform:rotate(2deg); overflow:hidden; }
  .passport::before { content:''; position:absolute; width:180px; height:180px; right:-55px; top:30px; border:3px dashed var(--orange); border-radius:50%; }
  .passport strong { z-index:1; font:900 5rem/1 'IBM Plex Mono',monospace; letter-spacing:-.09em; }
  .passport span { font-weight:900; font-size:1.08rem; }
  .passport i { width:max-content; color:var(--orange); border:3px solid; padding:5px; transform:rotate(-7deg); font-style:normal; font-weight:900; }
  .toc hr { border:0; border-top:1.5px dashed; margin:14px 0; }
  .toc a.sub { padding-left:12px; font-size:.82rem; }
  .toc small a { display:inline; text-decoration:underline; }
  @media(max-width:800px){.hero-grid{grid-template-columns:1fr}.passport{display:none}.breadcrumbs{margin-bottom:22px}}
</style>
